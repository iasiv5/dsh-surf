{
  "name": "dsh-surf",
  "version": "0.1.0",
  "description": "Surf launcher plugin for DeepSeek Harness: a thin shell.overlay entry that opens a self-hosted Selkies/Chrome streaming surface",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "deploy/"
  ],
  "license": "MIT",
  "author": "iasiv5",
  "keywords": [
    "dsh",
    "plugin",
    "surf",
    "selkies",
    "chrome"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
